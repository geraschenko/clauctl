{
  "name": "clauctl",
  "version": "0.1.0",
  "description": "Spawn, observe, control, and attach to claude instances",
  "license": "Apache-2.0",
  "author": "Anton Geraschenko <geraschenko@gmail.com>",
  "homepage": "https://github.com/geraschenko/clauctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geraschenko/clauctl.git"
  },
  "bugs": {
    "url": "https://github.com/geraschenko/clauctl/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "clauctl": "dist/core/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/core/main.js', 0o755)\"",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test \"src/**/*.test.ts\"",
    "fmt": "treefmt",
    "sync": "node scripts/sync-from-pictl.mjs",
    "presubmit": "npm run check && npm run lint && node scripts/sync-from-pictl.mjs --check && treefmt --fail-on-change && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.195",
    "@earendil-works/pi-tui": "0.80.3",
    "@stricli/auto-complete": "^1.2.8",
    "@stricli/core": "^1.2.8",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^5.5.0",
    "env-paths": "^4.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  }
}
