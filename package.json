{
  "name": "@geraschenko/clauctl",
  "version": "0.2.0",
  "description": "Spawn, observe, control, and attach to claude instances",
  "keywords": [
    "claude",
    "claude-agent-sdk",
    "agent",
    "tui",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Anton Geraschenko <geraschenko@gmail.com>",
  "homepage": "https://github.com/geraschenko/clauctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geraschenko/clauctl.git"
  },
  "bugs": {
    "url": "https://github.com/geraschenko/clauctl/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "clauctl": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "lint": "eslint src tests",
    "depcruise": "dependency-cruise src --include-only \"^src\"",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:api": "node --test \"src/**/*.apitest.ts\"",
    "test:sdk": "node --test \"tests/sdk/**/*.test.ts\"",
    "fmt": "treefmt",
    "sync": "node scripts/sync-from-pictl.mjs",
    "presubmit": "npm run check && npm run lint && npm run depcruise && node scripts/sync-from-pictl.mjs --check && node scripts/claude-tools/generate.ts --check && treefmt --fail-on-change && npm test",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@geraschenko/renderdag": "^0.1.1",
    "@stricli/auto-complete": "^1.2.8",
    "@stricli/core": "^1.2.8",
    "env-paths": "^4.0.0",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "fast-check": "^4.9.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  }
}
